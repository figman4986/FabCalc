<?xml version="1.0" encoding="utf-8"?><!--
    Explicit app-data includes for cloud backup and device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="history.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="wireDatasheets/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="history.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="wireDatasheets/" />
    </device-transfer>
</data-extraction-rules>
